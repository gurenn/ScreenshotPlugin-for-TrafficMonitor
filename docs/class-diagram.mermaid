class GlyphSink {
    <<abstract>>
    +Fill(int x, int y, int w, int h, unsigned long color)
    +Frame(int x, int y, int w, int h, unsigned long color, int width, bool dot, int radius)
    +Line(int x1, int y1, int x2, int y2, unsigned long color, int width)
}
class DrawerSink {
    -IPluginDrawer* m_d
    +Fill(...)
    +Frame(...)
    +Line(...)
}
class HdcSink {
